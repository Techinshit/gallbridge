{
  "manifest_version": 3,
  "name": "갤브릿지",
  "description": "디시인사이드 목록 자동 갱신, IP 구분, 회원 아이디, 차단글 숨김, 다크 모드",
  "version": "2026.11.1",
  "action": {
    "default_title": "갤브릿지",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://gall.dcinside.com/*"],
  "content_scripts": [
    {
      "matches": ["https://gall.dcinside.com/*"],
      "js": ["early.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://gall.dcinside.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
